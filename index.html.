<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shark Tank Question Simulator</title><style>:root{font-family:Arial,sans-serif;color:#172033;background:#f3f6fb}*{box-sizing:border-box}body{margin:0}.wrap{max-width:880px;margin:30px auto;padding:20px}header{background:#10233f;color:white;border-radius:18px;padding:26px}h1{margin:0 0 8px}header p{margin:0;color:#dce7f5}.panel{background:white;border-radius:16px;padding:22px;margin-top:18px;box-shadow:0 3px 15px #10233f12}label{font-weight:700;display:block;margin-bottom:8px}select,textarea,input{width:100%;border:1px solid #bcc8d6;border-radius:9px;padding:12px;font:inherit}textarea{min-height:130px;resize:vertical}button{background:#173b6b;color:white;border:0;padding:12px 17px;border-radius:9px;cursor:pointer;font-weight:700;margin:5px 7px 5px 0}button.secondary{background:#e6edf5;color:#173b6b}button:disabled{opacity:.5;cursor:not-allowed}.question{font-size:1.55rem;font-weight:700;line-height:1.35;margin:18px 0}.tag{display:inline-block;background:#eaf0f9;color:#234d7a;padding:6px 10px;border-radius:99px;font-size:.85rem;font-weight:700}.muted{color:#5e6b7a}.hidden{display:none}.row{display:grid;grid-template-columns:1fr 1fr;gap:15px}.feedback{border-left:4px solid #1e6099;background:#f0f6ff;padding:14px;border-radius:6px}ul{padding-left:22px}li{margin-bottom:7px}@media(max-width:600px){.row{grid-template-columns:1fr}.wrap{margin:0;padding:12px}.question{font-size:1.25rem}}</style></head><body><div class="wrap"><header><h1>🦈 Shark Tank Question Simulator</h1><p>Practice thinking like an entrepreneur. Answer the Sharks with clear business reasoning.</p></header><section class="panel"><div class="row"><div><label for="company">Business name (optional)</label><input id="company" placeholder="Your business name"></div><div><label for="category">Question category</label><select id="category"><option value="all">All categories — random</option><option value="opportunity">Opportunity & Innovation</option><option value="competition">Competition & Advantage</option><option value="model">Business Model & Growth</option><option value="decision">Unexpected Business Scenarios</option></select></div></div><button id="draw">Get a Shark Question</button><button id="reset" class="secondary">Start Over</button><p class="muted" id="count">Questions practiced: 0</p></section><section class="panel hidden" id="questionPanel"><span class="tag" id="tag"></span><div class="question" id="question"></div><label for="answer">Your response</label><textarea id="answer" placeholder="State your decision, explain why, and describe how it impacts your business..."></textarea><div><button id="check">Review My Answer</button><button id="next" class="secondary">Next Question →</button></div><div id="feedback" class="hidden feedback"></div></section><section class="panel"><strong>How to earn Proficient (3.0)</strong><p>Give a realistic, specific answer. Explain why your decision makes sense and how it could affect customers, sales, costs, or growth.</p><p class="muted">This simulator provides reflection prompts, not automatic grades. Your teacher evaluates your actual business reasoning.</p></section></div><script>const bank={opportunity:["What specific problem does your business solve, and who experiences it most often?","How do you know your target customers would want this solution?","What makes your improvement innovative rather than just different?","Why is this problem important enough that customers would pay to solve it?","What would customers lose if your business did not exist?","Explain your product's value in one sentence without using the words 'better' or 'cool'."],competition:["Who is your strongest competitor, and what do they do well?","Why would a customer switch from an existing competitor to your business?","What is one weakness in your competitor's offering that you can address?","What stops a larger company from copying your idea?","What will you do if customers say your competitor is more trustworthy?","Why should someone choose you if both businesses charge the same price?"],model:["Exactly how does your business earn money?","How did you decide on your selling price?","What are your two biggest expenses, and how will you manage them?","How many sales would you need to cover your costs?","What is your most realistic opportunity for growth?","How will you use the investment money you are asking for?","What could prevent your business from becoming profitable?"],decision:["A competitor starts selling a similar product for 20% less. What will you do, and why?","Your main supplier raises prices by 25%. How will you respond?","Demand doubles overnight, but you cannot fulfill every order. What is your plan?","Customers begin leaving negative reviews about one feature. What will you change?","Your target audience starts losing interest. How will you adapt?","An investor offers the money you requested but wants twice as much ownership. How do you respond?","A major competitor launches a feature that makes your biggest advantage less unique. What next?","You have money to either advertise more or improve your product, but not both. Which do you choose and why?","Your business has strong sales but is losing money. What will you investigate first?","A new market offers growth, but expanding there would increase costs substantially. How will you decide?"]};const labels={opportunity:'Business Opportunity & Innovation',competition:'Competition & Competitive Advantage',model:'Business Model & Growth',decision:'Business Decision-Making'};let used=new Set(),total=0,current='';const $=id=>document.getElementById(id);function draw(){let cat=$('category').value;let pool=Object.entries(bank).flatMap(([k,arr])=>arr.map((q,i)=>({k,q,id:k+i}))).filter(x=>(cat==='all'||x.k===cat)&&!used.has(x.id));if(!pool.length){used.clear();pool=Object.entries(bank).flatMap(([k,arr])=>arr.map((q,i)=>({k,q,id:k+i}))).filter(x=>cat==='all'||x.k===cat)}let item=pool[Math.floor(Math.random()*pool.length)];used.add(item.id);current=item.k;$('tag').textContent=labels[item.k];$('question').textContent=item.q;$('answer').value='';$('feedback').classList.add('hidden');$('questionPanel').classList.remove('hidden');total++;$('count').textContent='Questions practiced: '+total;$('questionPanel').scrollIntoView({behavior:'smooth',block:'start'})}function check(){let ans=$('answer').value.trim();let prompts=current==='decision'?['Did you describe a specific action?','Did you explain why that action is realistic?','Did you explain a likely consequence for sales, costs, customers, or growth?']:['Did you answer the question directly with details from your own business?','Did you explain why your claim or decision makes sense?','Did you connect your answer to customer value, competition, or profitability?'];$('feedback').innerHTML='<strong>Self-check your response:</strong><ul>'+prompts.map(x=>'<li>'+x+'</li>').join('')+'</ul><strong>Next step:</strong> If any answer is no, add one specific example or explanation before moving on.'+(ans.length<35?'<p><strong>Tip:</strong> Your response is brief. Add more reasoning and business-specific detail.</p>':'');$('feedback').classList.remove('hidden')} $('draw').onclick=draw;$('next').onclick=draw;$('check').onclick=check;$('reset').onclick=()=>{used.clear();total=0;$('count').textContent='Questions practiced: 0';$('questionPanel').classList.add('hidden');$('answer').value=''};</script></body></html>
